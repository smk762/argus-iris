# Copy to deploy/.env (gitignored). Compose reads .env from the compose file's directory, so
# `docker compose -f deploy/broker.compose.yaml up -d` (or agent.compose.yaml) picks it up from here.
# The broker and the agents run on different hosts; each host only needs its own section.
#
# Values several Argus services share (ARGUS_GPU_BROKER_TOKEN, a service's admin token) can live once in the suite
# file instead (argus_cortex.settings: ~/.config/argus/suite.env, mode 600), mounted into the broker at
# /etc/argus/suite.env (see the commented volume in broker.compose.yaml). The broker reads from it only the tokens
# its config names, and only where the variable is blank here. The agent never reads it.

# --- Shared --------------------------------------------------------------------------------------
IRIS_TAG=latest
# Interface the published port binds to. Keep it on the LAN; reaching the port is host access.
HOST_IP=0.0.0.0
# Broker -> agent token for container actions. Same value on the broker and on every agent.
# Unset on an agent disables its container actions. Generate with: openssl rand -hex 32
IRIS_AGENT_TOKEN=

# --- Broker (one host, :8120) --------------------------------------------------------------------
# Path (relative to deploy/) of the broker config; start from iris.example.yaml.
IRIS_CONFIG_FILE=./iris.yaml
# Residency policy (idle-kill, keepalive). Copy policy.example.yaml to policy.yaml, then point this at it.
IRIS_POLICY_FILE=./policy.example.yaml
# Callers' token (what argus-cortex's BrokerCoordinator sends). Manual actions such as warm are
# disabled while unset.
ARGUS_GPU_BROKER_TOKEN=
# Tokens named by token_env in iris.yaml:
# A service's /admin/* token. Reads stay open without it.
ARGUS_ADMIN_TOKEN=
# Only if a service's token_env names it: an API key for agent-composer's resident gateway.
RAG_CHAT_API_KEY=
# argus-echo engines' admin token.
ECHO_ADMIN_TOKEN=
# argus-lens's /admin/* token (its own ARGUS_ADMIN_TOKEN), for the lens service's token_env.
LENS_ADMIN_TOKEN=

# --- Agent (each GPU host, :9110) ----------------------------------------------------------------
# Required: a short name for this host's GPU, e.g. rtx3090.
IRIS_AGENT_NODE=
IRIS_AGENT_POLL_S=5
# Comma-separated containers the broker may start/stop/restart on this host, e.g. comfyui.
# Nothing else is ever touched; broker config cannot widen this.
IRIS_AGENT_CONTAINERS=
