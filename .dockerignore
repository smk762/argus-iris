# .git is *not* ignored: the builder stage reads the version from it (hatch-vcs) and it never reaches the final image.
# Don't ignore tracked files either: git would call the tree dirty, and the version would say so.
.venv
venv
dist
build
*.egg-info
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Local secrets and live configuration. Patterns match from the context root, so subdirectories need the **/.
**/.env
**/.env.*
!**/.env.example
deploy/iris.yaml
deploy/policy.yaml
**/*.bak*
