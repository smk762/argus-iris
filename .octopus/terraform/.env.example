# cp .env.example .env, fill in, then: set -a; . ./.env; set +a; terraform init && terraform apply
# .env is gitignored. Terraform state also holds both secrets, so it stays local too.

# Your instance, no trailing slash.
TF_VAR_octopus_url=https://example.octopus.app

# Octopus API key (Profile -> My API keys). It must be able to create a space, so: Full access.
TF_VAR_octopus_api_key=API-XXXXXXXXXXXXXXXXXXXXXXXXXX

# Who manages the Argus space, as a JSON list of user ids. Yours is the "Id" in /api/users/me:
#   curl -s -H "X-Octopus-ApiKey: $TF_VAR_octopus_api_key" "$TF_VAR_octopus_url/api/users/me"
TF_VAR_space_managers='["Users-1"]'

# Fine-grained GitHub token: repository smk762/argus-iris only, Contents read and write.
# Octopus commits deployment process changes (Config as Code) on a branch with it.
TF_VAR_github_token=github_pat_XXXXXXXXXXXXXXXXXXXXXX

# First apply only: the project's conversion to Git commits OCL to this branch, and dev is protected. Merge that branch
# (a PR to dev), then remove this line and apply again.
# TF_VAR_git_default_branch=feat/octopus-deploy

# After the process has its first step (see ../README.md, step 5):
# TF_VAR_release_trigger=true

# After the Health check runbook is on the default branch: schedule it hourly.
# TF_VAR_health_check_trigger=true
